# Vestaboard Read/Write API key (from the Vestaboard app → Settings → API keys).
# Required for `paint` and `run`; NOT needed for `preview`.
VESTABOARD_RW_KEY=

# Which job the daemon (`run`) paints. One of: clock, muni, world_cup,
# sport_highscores, sport_lowscores, spotify.
ACTIVE_JOB=clock

# Glyph font: a file <FONT>.json in fonts/. Bundled: nanofont3x4, bytesized3x4, 3x3pixels, 3by5.
FONT=bytesized3x4

# Accent colors. Use a name (red orange yellow green blue violet/purple white
# black filled) or a code (63-71). CLOCK_COLOR is the big time color.
CLOCK_COLOR=white
# MUNI_COLOR overrides the L badge color. Leave blank to use the line's own
# color (L Taraval = purple). Muni line colors: J=yellow K=blue L=purple
# M=green N=blue T=red.
MUNI_COLOR=

# Small 2-char timezone label shown in the clock's corner (e.g. PT, ET).
CLOCK_TZ_LABEL=PT

# SF Muni (511.org). Get a free token at https://511.org/open-data/token
# MUNI_STOP_CODE is the L Taraval stop code (e.g. an inbound/outbound stop id).
FIVEONEONE_API_KEY=
MUNI_STOP_CODE=

# World Cup job (no API key). Optionally pin a group (e.g. C); blank = all.
# Rotates among live matches every N seconds (or immediately on a score change).
WORLDCUP_GROUP=
WORLDCUP_ROTATE_SECONDS=300

# Sport high-scores job (no API key, ESPN). ESPN sport/league path + cadence.
# Examples: basketball/nba, basketball/mens-college-basketball, football/nfl.
SPORT_LEAGUE=basketball/nba
SPORT_ROTATE_SECONDS=300

# Spotify "now playing" job. Create an app at https://developer.spotify.com,
# set the redirect URI below in the app, then run `artistaboard spotify-auth`.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ─── Web app (`serve`) & data layer (`poll`) ────────────────────────────────
# Only needed if you run the web app / poller; the CLI jobs above don't require them.

# Database. Defaults to a local SQLite file; the poller (`poll`) is Postgres-only.
# Postgres example: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./artistaboard.db

# Deployment environment. Keep "dev" locally. Set to "prod" (anything != "dev")
# in a real deployment — this REJECTS the insecure default secret at startup.
APP_ENV=dev

# Signs the auth session cookie. A public dev default is used when unset, which is
# rejected unless APP_ENV=dev. Generate one: `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SESSION_SECRET=

# Encrypts board Read/Write keys at rest (Fernet). Falls back to SESSION_SECRET when
# unset; set a dedicated key in any real deployment. Generate as above.
APP_ENCRYPTION_KEY=

# Whether new-account signup is allowed after the first owner account exists.
ALLOW_SIGNUP=true

# Browser origins allowed to call the API with credentials (JSON list or comma-
# separated). Only needed for the Vite dev server; prod serves the SPA same-origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Poller cadence (cron). Default: every minute.
POLL_CRON=* * * * *
